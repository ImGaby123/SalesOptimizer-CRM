         <property name="styleSheet">
          <string notr="true">/*  Put Here the Style Sheeeeeeeeeeettttttttttttt for le Beuton - Gaby Plaza  */

/*
This is the Order of Stuff:
- Line Edit
- Labels
- Button
- Combo Box
*/



/* Line Edit Design Here*/
QLineEdit {
    background-color: #262626;
    border: 1px solid #737373;
    color: white;
	border-radius: 10px;
	padding: 5px;
	font: 10pt &quot;Segoe UI&quot;;
}

/* Labels Design Here*/
QLabel {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);               
}


/* Button Design Here*/
QPushButton {
    background-color: #262626;
    border: 1px solid #737373;
    color: white;
    border-radius: 5px;
    padding: 5px;
    font: 10pt &quot;Segoe UI&quot;;
    text-align: center;
	padding-left: 20px;
    padding-right: 20px;
}

QPushButton:hover {
    background-color: rgb(200, 200, 200);  /* Darker gray on hover */
    color: rgb(0, 0, 0);
}

QPushButton:pressed {
    background-color: rgb(180, 180, 180);  /* Darker gray on press */
}



/* Combo Boxes Design Here*/
QComboBox {
    background-color: #262626;
    border: 1px solid #737373;
    color: white;
    border-radius: 10px;
    padding: 5px;
    font: 10pt &quot;Segoe UI&quot;;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #262626;
    color: white;
    border-radius: 10px;
}
</string>
         </property>
