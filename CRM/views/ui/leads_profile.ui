    border: 1px solid #16D4FF; /* Blue border */
    color: #16D4FF; /* Blue text */
    border-radius: 10px; /* Rounded corners */
    padding: 8px 16px; /* Padding to give some space */
    text-align: center; /* Center the text */
    font-size: 14px; /* Adjust font size */
    font-weight: bold; /* Bold text */
}

QPushButton:hover {
    background-color: #3A3A3A; /* Dark gray background on hover */
    color: #FFFFFF; /* White text on hover */
    border-color: #1E90FF; /* Slightly lighter blue border on hover */
}

QPushButton:pressed {
    background-color: #5A5A5A; /* Darker gray background on press */
    color: #FFFFFF; /* White text on press */
    border-color: #1E90FF; /* Keep the blue border color when pressed */
}
</string>
