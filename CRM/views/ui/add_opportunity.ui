            <property name="styleSheet">
             <string notr="true">QDateEdit {
    background-color: #FFFFFF;    /* White background */
    color: black;                 /* Black text */
    border: 1px solid #BFBFBF;    /* Light gray border */
    border-radius: 5px;
    padding: 5px 25px 5px 10px;   /* Extra padding for the drop-down icon */
}

/* Drop-down area */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background-color: transparent;
}

/* Calendar icon (set the path to your calendar icon) */
QDateEdit::down-arrow {
    image: url(:/Resources/calendar.png);  /* Replace with your own icon */
    width: 16px;
    height: 16px;
    margin-right: 14px;
}

/* Hover effect */
QDateEdit:hover {
    background-color: #F0F0F0;     /* Light gray background on hover */
    color: black;
    border: 1px solid #16D4FF;      /* Border turns blue when hovered */
}

/* Focus effect (when clicked) */
QDateEdit:focus {
    border: 1px solid #16D4FF;      /* Blue border when focused */
    background-color: #F9F9F9;      /* Slightly lighter background */
}

/* Calendar popup container (QCalendarWidget) */
QCalendarWidget {
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #BFBFBF;
    border-radius: 6px;
    font: 10pt &quot;Segoe UI&quot;;
}

/* Header navigation bar (month/year buttons &amp; arrows) */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #F0F0F0;
}

QCalendarWidget QToolButton {
    background-color: #E5E5E5;
    color: #000000;
    border: none;
    font-weight: bold;
    padding: 5px;
}

QCalendarWidget QToolButton:hover {
    background-color: #DADADA;
}

/* Remove down arrow on month/year combo (optional) */
QCalendarWidget QToolButton::menu-indicator {
    image: none;
}

/* Weekday labels (Mon-Sun) */
QCalendarWidget QHeaderView {
    background-color: #F5F5F5;
}

QCalendarWidget QHeaderView::section {
    color: #555555;
    background-color: #F5F5F5;
    border: none;
    padding: 5px;
}

/* Day numbers */
QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    color: #000000;
    selection-background-color: #16D4FF;  /* Highlighted date */
    selection-color: #000000;
    gridline-color: #D0D0D0;
}

/* Today highlight */
QCalendarWidget QWidget#qt_calendar_today {
    border: 1px solid #16D4FF;
    background-color: #F0F0F0;
    border-radius: 4px;
}
</string>
