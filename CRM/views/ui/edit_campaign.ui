                <property name="styleSheet">
                 <string notr="true">/* QDateEdit main field */
QDateEdit {
    color: #171717;
    background-color: #E5E5E5;
    border: 1px solid #171717;
    border-radius: 5px;
    padding: 4px;
}

/* Drop-down area */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    background-color: transparent;
}

/* Calendar icon */
QDateEdit::down-arrow {
    image: url(:/Resources/calendar.png);  /* use a dark icon on E5E5E5 background */
    width: 16px;
    height: 16px;
    margin-right: 14px;
}

/* Hover */
QDateEdit:hover {
    background-color: #E5E5E5;
    color: #171717;
    border: 1px solid #171717;
}

/* Focus */
QDateEdit:focus {
    border: 1px solid #171717;
    background-color: #DADADA;
    color: #171717;
}

/* Calendar popup */
QCalendarWidget {
    background-color: #E5E5E5;
    color: #171717;
    border: 1px solid #171717;
    border-radius: 6px;
    font: 10pt &quot;Segoe UI&quot;;
}

/* Header navigation bar */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #DADADA;
}

QCalendarWidget QToolButton {
    background-color: #CCCCCC;
    color: #171717;
    border: none;
    font-weight: bold;
    padding: 5px;
}

QCalendarWidget QToolButton:hover {
    background-color: #BFBFBF;
}

/* Remove dropdown arrow from tool buttons */
QCalendarWidget QToolButton::menu-indicator {
    image: none;
}

/* Weekday headers */
QCalendarWidget QHeaderView {
    background-color: #DADADA;
}

QCalendarWidget QHeaderView::section {
    color: #171717;
    background-color: #DADADA;
    border: none;
    padding: 5px;
}

/* Days view */
QCalendarWidget QAbstractItemView {
    background-color: #E5E5E5;
    color: #171717;
    selection-background-color: #171717;  /* Black highlight for selected */
    selection-color: #E5E5E5;             /* Light text on dark selection */
    gridline-color: #BFBFBF;
}

/* Today cell */
QCalendarWidget QWidget#qt_calendar_today {
    border: 1px solid #171717;
    background-color: #DADADA;
    border-radius: 4px;
}

/* Month/year dropdown */
QCalendarWidget QMenu {
    background-color: #E5E5E5;
    color: #171717;
    border: 1px solid #171717;
}
</string>
